<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FANCODE EVENTS</title>

<style>
:root{
  --bg:#050b18;--card:#0b162c;--accent:#e11d48;
  --live:#22c55e;--upcoming:#f59e0b;
  --text:#e5e7eb;--muted:#94a3b8;
  --priority:#facc15;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:system-ui,-apple-system,Segoe UI,Roboto;
  background:radial-gradient(circle at top,#0b1633,#050b18 70%);
  color:var(--text)
}

/* HEADER */
header{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:14px;
  padding:22px 20px;
  cursor:pointer;
}
header img{height:38px}
header span{
  font-size:26px;
  font-weight:700;
  letter-spacing:1px;
}

/* STATS */
.stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:16px;
  padding:0 20px 14px;
}
.stat{
  background:linear-gradient(135deg,#0b162c,#111c3a);
  padding:18px;
  border-radius:14px;
  text-align:center;
}
.stat span{color:var(--muted);font-size:14px}
.stat h2{margin:8px 0 0;font-size:32px}

/* TYPE FILTER */
.type-filter{
  display:flex;
  gap:10px;
  justify-content:center;
  padding:0 20px 14px;
}
.type-filter button{
  background:#0b162c;
  border:none;
  color:var(--text);
  padding:10px 20px;
  border-radius:999px;
  cursor:pointer;
  font-weight:600;
}
.type-filter button.active{
  background:var(--accent);
}

/* DROPDOWN FILTERS */
.filters{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  padding:0 20px 16px;
}
.filters select{
  width:100%;
  padding:12px;
  border-radius:12px;
  border:none;
  background:#0b162c;
  color:#fff;
  font-weight:600;
  appearance:none;
  text-align:center;
}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
  gap:20px;
  padding:0 20px 40px;
}
.card{
  background:var(--card);
  border-radius:18px;
  overflow:hidden;
}
.card img{
  width:100%;
  aspect-ratio:16/9;
  object-fit:cover;
}
.card-body{padding:16px}

/* BADGES */
.badge{
  display:inline-block;
  padding:4px 10px;
  border-radius:999px;
  font-size:12px;
  margin-bottom:6px;
}
.live{background:rgba(34,197,94,.15);color:var(--live)}
.upcoming{background:rgba(245,158,11,.15);color:var(--upcoming)}
.priority{
  background:rgba(250,204,21,.15);
  color:var(--priority);
  margin-left:6px;
}

.title{font-weight:600}
.tournament{color:var(--muted);font-size:14px}
.meta{margin-top:6px;font-size:13px;color:var(--muted)}

/* WATCH */
.watch-select{
  margin-top:12px;
  width:100%;
  padding:10px;
  border-radius:10px;
  border:none;
  background:var(--accent);
  color:#fff;
  font-weight:600;
  cursor:pointer;
  appearance:none;
  text-align:center;
}

/* TV / ANDROID */
button:focus,select:focus{
  outline:3px solid var(--accent);
}
</style>
</head>

<body>

<header onclick="location.reload()">
  <span>⚡FANCODE EVENTS BY DHRUV⚡</span>
</header>

<section class="stats">
  <div class="stat"><span>Total</span><h2 id="total">0</h2></div>
  <div class="stat"><span>Live</span><h2 id="live">0</h2></div>
  <div class="stat"><span>Upcoming</span><h2 id="upcoming">0</h2></div>
</section>

<div class="type-filter">
  <button class="active" onclick="setType('ALL')">TOTAL</button>
  <button onclick="setType('LIVE')">LIVE</button>
  <button onclick="setType('UPCOMING')">UPCOMING</button>
</div>

<div class="filters">
  <select id="categoryFilter" onchange="render()">
    <option value="ALL">CATEGORIES</option>
  </select>

  <select id="tournamentFilter" onchange="render()">
    <option value="ALL">TOURNAMENTS</option>
  </select>
</div>

<section class="grid" id="events"></section>

<script>
const API='https://raw.githubusercontent.com/jitendra-unatti/fancode/refs/heads/main/data/fancode.json';
const PRIORITY_MATCHES=[];

let allMatches=[],currentType='ALL';

async function loadEvents(){
  const res=await fetch(API);
  const data=await res.json();

  total.textContent=data.total_matches;
  live.textContent=data.live_matches;
  upcoming.textContent=data.upcoming_matches;

  allMatches=data.matches.sort((a,b)=>
    PRIORITY_MATCHES.includes(b.match_id) -
    PRIORITY_MATCHES.includes(a.match_id)
  );

  buildFilters();
  render();
}

function buildFilters(){
  const catSel=document.getElementById('categoryFilter');
  const tourSel=document.getElementById('tournamentFilter');

  [...new Set(allMatches.map(m=>m.category))]
    .forEach(c=>catSel.innerHTML+=`<option>${c}</option>`);

  [...new Set(allMatches.map(m=>m.tournament))]
    .forEach(t=>tourSel.innerHTML+=`<option>${t}</option>`);
}

function setType(t){
  currentType=t;
  document.querySelectorAll('.type-filter button')
    .forEach(b=>b.classList.remove('active'));
  event.target.classList.add('active');
  render();
}

function countdown(start){
  const d=new Date(start)-new Date();
  if(d<=0)return '';
  return `Starts in ${Math.floor(d/36e5)}h ${Math.floor(d%36e5/6e4)}m`;
}

function render(){
  const cat=categoryFilter.value;
  const tour=tournamentFilter.value;

  events.innerHTML='';
  for(const m of allMatches){
    if(currentType==='LIVE' && m.streamingStatus!=='STARTED') continue;
    if(currentType==='UPCOMING' && m.streamingStatus==='STARTED') continue;
    if(cat!=='ALL' && m.category!==cat) continue;
    if(tour!=='ALL' && m.tournament!==tour) continue;

    const liveNow=m.streamingStatus==='STARTED';
    const priority=PRIORITY_MATCHES.includes(m.match_id);
    const cdn=m.STREAMING_CDN||{};

    events.innerHTML+=`
      <div class="card">
        <img src="${m.image}">
        <div class="card-body">
          <span class="badge ${liveNow?'live':'upcoming'}">
            ${liveNow?'LIVE':'UPCOMING'}
          </span>
          ${priority?'<span class="badge priority">⭐ PRIORITY</span>':''}
          <div class="title">${m.title}</div>
          <div class="tournament">${m.tournament}</div>
          <div class="meta">${m.category} • ${m.startTime}</div>
          ${!liveNow?`<div class="meta">${countdown(m.startTime)}</div>`:''}
          ${liveNow?`
            <select class="watch-select"
              onchange="location.href='player.html?stream='+encodeURIComponent(this.value)">
              <option value="">WATCH LIVE</option>
              ${cdn.Primary_Playback_URL?`<option value="${cdn.Primary_Playback_URL}">Primary</option>`:''}
              ${cdn.fancode_cdn?`<option value="${cdn.fancode_cdn}">FanCode</option>`:''}
              ${cdn.dai_google_cdn?`<option value="${cdn.dai_google_cdn}">DAI</option>`:''}
            </select>`:''}
        </div>
      </div>`;
  }
}

loadEvents();
setInterval(loadEvents,60000);
</script>

</body>
</html>
